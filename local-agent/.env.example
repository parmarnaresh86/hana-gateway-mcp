RENDER_URL=wss://your-app.onrender.com/agent
CONNECTOR_ID=office-pc
CONNECTOR_TOKEN=change-me-generate-with-openssl-rand-hex-32

# --- HANA (ODBC) - leave blank to skip if this connector only serves Service Layer ---
# Requires the SAP HANA ODBC driver (HDBODBC) installed on this machine.
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
# Only needed when connecting via the system-DB port to a named tenant DB (MDC).
HANA_DATABASE=
HANA_ENCRYPT=false
# Advanced: override the whole ODBC connection string instead of the fields above.
HANA_CONNECTION_STRING=

# --- SAP Business One Service Layer - leave blank to skip if this connector only serves HANA ---
SAP_B1_BASE_URL=https://your-b1-server:50000/b1s/v1
SAP_B1_COMPANY=
SAP_B1_USER=
SAP_B1_PASSWORD=
# Set to false only for self-signed/internal certs you trust.
SAP_B1_REJECT_UNAUTHORIZED=true
